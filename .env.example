# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올리지 않는다.
# IDE 실행 구성이나 배포 환경의 환경변수로 넣어주면 된다.

# --- 서버가 열 주소/포트 ---
SERVER_PORT=8090
# 0.0.0.0 = 외부 접속 허용 / 127.0.0.1 = 같은 장비에서만 (리버스 프록시 뒤)
SERVER_ADDRESS=0.0.0.0

# --- DB (별도 DB 서버 접속정보) ---
# PostgreSQL : jdbc:postgresql://호스트:5432/yudillo
# MySQL      : jdbc:mysql://호스트:3306/yudillo?serverTimezone=UTC
# SQL Server : jdbc:sqlserver://호스트:1433;databaseName=yudillo;encrypt=true;trustServerCertificate=true
DB_URL=jdbc:postgresql://localhost:5432/yudillo
DB_USERNAME=yudillo
DB_PASSWORD=yudillo

# --- JWT ---
# HS256 대칭키. 최소 32바이트 이상의 랜덤 문자열을 쓴다.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# --- 응답 날짜 형식 ---
# pattern 을 iso 로 두면 ISO-8601(2026-09-28T01:38:03.825Z)로 나간다.
# 값에 공백이 있으므로 반드시 따옴표로 감싼다 (안 그러면 source 시 깨짐)
DATETIME_PATTERN="yyyy-MM-dd HH:mm:ss"
DATETIME_ZONE=Asia/Seoul

# --- CORS (프론트엔드 오리진, 쉼표로 여러 개) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 실행 프로필 ---
SPRING_PROFILES_ACTIVE=local
